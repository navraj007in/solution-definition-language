{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:sdl:release-manifest:v1",
  "title": "SDL release manifest v1",
  "type": "object",
  "additionalProperties": false,
  "patternProperties": { "^x-": {} },
  "required": ["format", "id", "languageVersion", "status", "published", "authority"],
  "properties": {
    "format": { "const": "sdl-release-manifest/v1" },
    "id": { "type": "string", "pattern": "^sdl-v[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
    "languageVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "active", "superseded", "retired"] },
    "published": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "supersedes": { "type": "string", "pattern": "^sdl-v[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
    "successor": { "type": "string", "pattern": "^sdl-v[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$" },
    "authority": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/Authority" }
    },
    "notes": { "type": "string" }
  },
  "definitions": {
    "Authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "role", "precedence", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[^\\\\]+$"
        },
        "role": {
          "enum": ["normative-prose", "structural-schema", "normative-corpus", "derived-reference"]
        },
        "precedence": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}
