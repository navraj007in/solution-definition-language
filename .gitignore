# @sdl/core (and its in-progress v2 successor) are the language reference
# implementations — their dependency graphs are committed so `npm ci` in CI
# (and any local install) reproduces exactly what was tested, instead of
# "^"-range resolution drifting between runs.
!packages/sdl/package-lock.json
!packages/core-v2/package-lock.json
